*pro.user


**/.vs/
.vscode/
build/
libs/
config.tests/*/.qmake.stash
config.tests/*/Makefile

# --- qmake / build output (macOS local builds) -----------------------------
# qmake generates these next to the sources rather than in build/, so they
# cannot be covered by the build/ rule above.
.qmake.cache
.qmake.stash
Makefile
Makefile.Debug
Makefile.Release
release/
debug/
*.o
*.a
config.log
app/Moonlight.app/
app/qml_qmlcache.qrc

# Generated by the macOS build from app/Info.plist (see app/app.pro). Lands in
# the source tree when building in-source rather than a shadow dir.
app/Info.generated.plist
