<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
	<id>com.moonlight_stream.Moonlight</id>
	<metadata_license>CC0-1.0</metadata_license>
	<project_license>GPL-3.0+</project_license>
	<name>Bulan</name>
	<summary>Stream games from your PC, on a controller</summary>

	<description>
		<p>Bulan is a controller-first fork of Moonlight, built for the Steam Deck. It can stream games and other applications from another PC with Sunshine or GeForce Experience software installed.</p>
		<p>Features include:</p>
		<ul>
			<li>Hardware accelerated video decoding with VAAPI, VDPAU, and Vulkan Video support</li>
			<li>H.264, HEVC, and AV1 codec support</li>
			<li>7.1 surround sound audio support</li>
			<li>10-point multitouch support</li>
			<li>Gamepad support with force feedback for up to 16 players</li>
			<li>Support for both pointer capture (for games) and direct mouse control (for remote desktop)</li>
			<li>Support for passing system-wide keyboard shortcuts like Alt+Tab to the host</li>
		</ul>
	</description>

	<!-- Bulan's own project links. The component id, launchable, binary name and
	     icon below stay on the upstream app-ID: they are the installed identity
	     on machines that already have this, and renaming them needs a migration,
	     not a branding pass. -->
	<url type="homepage">https://github.com/laweirdo/bulan-qt</url>
	<url type="bugtracker">https://github.com/laweirdo/bulan-qt/issues</url>
	<url type="help">https://github.com/laweirdo/bulan-qt#readme</url>
	<url type="vcs-browser">https://github.com/laweirdo/bulan-qt</url>
	<developer id="io.github.laweirdo">
		<name>Bulan</name>
	</developer>
	<launchable type="desktop-id">com.moonlight_stream.Moonlight.desktop</launchable>
	<provides>
		<binary>moonlight</binary>
	</provides>
	<content_rating type="oars-1.1" />	

	<!-- Bulan's own palette, from the design-token singleton: accentPrimary for
	     light, bgBase for dark. Was upstream Moonlight's purple. -->
	<branding>
		<color type="primary" scheme_preference="light">#FFD9A0</color>
		<color type="primary" scheme_preference="dark">#0D1024</color>
	</branding>

	<!-- No screenshots. The two that were here were upstream Moonlight's, hosted
	     on moonlight-stream.org, and showed upstream's interface, which is
	     precisely what Bulan replaces. Presenting them as Bulan's would
	     misrepresent the application. Bulan's own belong here once there is a
	     place to host them; no element is better than a wrong one. -->

	<!-- Bulan's own releases. Upstream Moonlight's changelog is not reproduced
	     here: this list is what Bulan has shipped, and carrying 46 upstream
	     entries topped by 6.1.0 would present Moonlight's release number as
	     Bulan's own and read as a downgrade to anything that parses it. The
	     upstream release this fork is built on is credited in the description
	     and in the About screen. -->
	<releases>
		<release version="0.0.1" date="2026-08-09">
			<description>
				<p>First Bulan alpha. Early, private software: the core loop works end to end, and polish and validation are ongoing.</p>
				<ul>
					<li>A custom controller-first interface built for the Steam Deck</li>
					<li>First-run onboarding, host carousel, game library and settings shell</li>
					<li>The Bulan design system, with its own motion and atmosphere</li>
					<li>Streaming, discovery and pairing remain Moonlight's</li>
				</ul>
			</description>
		</release>
	</releases>

</component>
